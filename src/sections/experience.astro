---
import devsync from '@core'
import { defaultLang, getLangData } from '@core'
import { translations, type availableLangsType } from '@/devsync/fields-translations'
import TimelineItem from '@/components/timeline-item.astro'

const lang = (Astro.params.lang || defaultLang).toLowerCase() as availableLangsType
const profile = getLangData(devsync, lang)
const experience = profile.experience ?? []
const translation = translations[lang]

const now = new Date()
let earliestStart: Date | null = null
for (const exp of experience) {
	if (exp.date) {
		const startPart = exp.date.split('-')[0].trim()
		const [month, year] = startPart.split('/').map(Number)
		if (month && year) {
			const startDate = new Date(year, month - 1, 1)
			if (!earliestStart || startDate < earliestStart) {
				earliestStart = startDate
			}
		}
	}
}
const yearsOfExperience = earliestStart ? Math.ceil((now.getTime() - earliestStart.getTime()) / (1000 * 60 * 60 * 24 * 365.25)) : experience.length
---

{
	Array.isArray(experience) && experience.length > 0 && (
		<section id="experience" class="relative m-auto w-full max-w-4xl px-6 py-16">
			<div class="mb-12">
				<h2 class="bg-accent-light mb-2 inline-block rounded px-3 py-1 text-2xl font-bold lg:text-3xl">{translation['Professional Experience']}</h2>
				<span class="text-text-secondary ml-3 text-lg">
					↝ {yearsOfExperience + ' '} {yearsOfExperience === 1 ? translation['year of experience'] : translation['years of experience']}
				</span>
			</div>

			<ul class="relative">
				{experience.map((exp, i) => (
					<TimelineItem {...exp} index={i} isLast={i === experience.length - 1} />
				))}
			</ul>
		</section>
	)
}
